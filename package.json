{
  "name": "template",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "clean": "rm -rf **/{.turbo,dist,coverage}",
    "clean-all": "rm -rf **/{node_modules,.turbo,dist,coverage}",
    "dev:web": "waku dev",
    "dev:tests": "vitest run --watch",
    "build": "waku build",
    "start": "waku start",
    "check:types": "tsc --noEmit",
    "check:tests": "vitest run --coverage --passWithNoTests",
    "nofix:prettier": "prettier --check --cache --cache-strategy metadata .",
    "fix:prettier": "prettier --write --cache --cache-strategy metadata .",
    "nofix:eslint": "eslint --cache --max-warnings 0 --no-warn-ignored",
    "fix:eslint": "eslint --cache --max-warnings 0 --no-warn-ignored --fix",
    "turbo:check-fix": "turbo check-fix",
    "turbo:check-nofix": "turbo check-nofix",
    "turbo:dev-web": "turbo dev:web",
    "turbo:dev-tests": "turbo dev:tests"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@stylexjs/stylex": "^0.19.1",
    "@types/node": "^26.6.4",
    "airtable": "^0.12.2",
    "qrcode": "^1.5.4",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-icons": "^5.7.0",
    "react-server-dom-webpack": "~19.3.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "waku": "1.0.0-rc.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/eslint-plugin": "^10.3.6",
    "@eslint/js": "^10.0.1",
    "@img/sharp-linux-x64": "^0.35.5",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-turbo": "^2.11.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
